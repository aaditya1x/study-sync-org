# Browser-safe values. RLS policies must restrict access by authenticated user.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local server/API values. Never add a VITE_ prefix to secrets.
GEMINI_API_KEY=
# Set true only for a Gemini API project verified to have billing disabled.
# Uses free-tier Gemini 2.5 Flash-Lite Google Search grounding; never paid-fallbacks.
GEMINI_WEB_GROUNDING_FREE_TIER_ONLY=false
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=
